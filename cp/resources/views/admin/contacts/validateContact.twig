{% extends "layouts/app.twig" %}

{% block title %}{{ __('Contact Validation') }}{% endblock %}

{% block content %}
      <div class="page-wrapper">
        <!-- Page header -->
        <div class="page-header d-print-none">
          <div class="container-xl">
            <div class="row g-2 align-items-center">
              <div class="col">
                <div class="mb-1">
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                      <a href="{{route('home')}}"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><polyline points="5 12 3 12 12 3 21 12 19 12" /><path d="M5 12v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-8" /><rect x="10" y="12" width="4" height="4" /></svg></a>
                    </li>
                    <li class="breadcrumb-item">
                      <a href="{{route('listContacts')}}">{{ __('Contacts') }}</a>
                    </li>
                    <li class="breadcrumb-item">
                      <a href="/contact/update/{{ contact.identifier }}">{{ __('Contact') }} {{ contact.identifier }}</a>
                    </li>
                    <li class="breadcrumb-item active">
                      {{ __('Contact Validation') }}
                    </li>
                  </ol>
                </div>
                <h2 class="page-title">
                  {{ __('Contact Validation') }}
                </h2>
              </div>
            </div>
          </div>
        </div>
        <!-- Page body -->
        <div class="page-body">
          <div class="container-xl">
            <div class="col-12">
            {% include 'partials/flash.twig' %}
                <div class="card mb-3">
                    <div class="card-header py-3">
                        <h3 class="card-title">{{ __('Contact') }} {{ contact.identifier }}</h3>&nbsp;
                        <span class="status status-green">{{ contactStatus.status }}</span>
                        {% if contactLinked is not null %}
                        <span class="status status-azure">{{ __('Linked') }}</span>
                        {% endif %}
                        {% if validation_enabled is not null %}
                        &nbsp;<span class="status {% if contact_valid == 0 %}status-yellow{% else %}status-green{% endif %}" title="{% if contact_valid == 0 %}Pending Validation{% else %}Validated{% endif %}">
                            {% if contact_valid == 0 %}
                                {{ __('Pending Validation') }}
                            {% else %}
                                {{ __('Validated') }}
                            {% endif %}
                        </span>
                        {% endif %}

                      <div class="card-actions">
                        <div class="btn-list">
                          <a href="/contact/update/{{ contact.identifier }}" class="btn btn-outline-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                              <path d="M9 11l-4 4l4 4"/>
                              <path d="M5 15h11a4 4 0 0 0 0 -8h-1"/>
                            </svg>
                            {{ __('Back') }}
                          </a>
                        </div>
                      </div>
                    </div>

                    <div class="card-body py-3">
                      <div class="row g-2">

                        {% if verifyPhone == 'on' %}
                          <div class="col-12 col-md-4">
                            <div class="border rounded-3 p-3 h-100">
                              <div class="d-flex align-items-center">
                                <span class="avatar avatar-sm rounded-circle {{ phoneDetails ? 'bg-green-lt text-green' : 'bg-red-lt text-red' }} me-3">
                                  {% if phoneDetails %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                      <path d="M5 12l5 5l10 -10"/>
                                    </svg>
                                  {% else %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                      <path d="M18 6l-12 12"/>
                                      <path d="M6 6l12 12"/>
                                    </svg>
                                  {% endif %}
                                </span>

                                <div class="flex-fill">
                                  <div class="fw-semibold">{{ __('Phone') }}</div>
                                  <div class="small {{ phoneDetails ? 'text-green' : 'text-red' }}">{{ phoneDetails ? __('Format is valid') : __('Format is not valid') }}</div>
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endif %}

                        {% if verifyEmail == 'on' %}
                          {% set emailValid = emailDetails == 1 %}

                          <div class="col-12 col-md-4">
                            <div class="border rounded-3 p-3 h-100">
                              <div class="d-flex align-items-center">
                                <span class="avatar avatar-sm rounded-circle {{ emailValid ? 'bg-green-lt text-green' : 'bg-red-lt text-red' }} me-3">
                                  {% if emailValid %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                      <path d="M5 12l5 5l10 -10"/>
                                    </svg>
                                  {% else %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                      <path d="M18 6l-12 12"/>
                                      <path d="M6 6l12 12"/>
                                    </svg>
                                  {% endif %}
                                </span>

                                <div class="flex-fill">
                                  <div class="fw-semibold">{{ __('Email') }}</div>
                                  <div class="small {{ emailValid ? 'text-green' : 'text-red' }}">{{ emailValid ? __('Format is valid') : __('Format is not valid') }}</div>
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endif %}

                        {% if verifyPostal == 'on' %}
                          {% set postalValid = postalDetails is not empty %}

                          <div class="col-12 col-md-4">
                            <div class="border rounded-3 p-3 h-100">
                              <div class="d-flex align-items-center">
                                <span class="avatar avatar-sm rounded-circle {{ postalValid ? 'bg-green-lt text-green' : 'bg-red-lt text-red' }} me-3">
                                  {% if postalValid %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                      <path d="M5 12l5 5l10 -10"/>
                                    </svg>
                                  {% else %}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                      <path d="M18 6l-12 12"/>
                                      <path d="M6 6l12 12"/>
                                    </svg>
                                  {% endif %}
                                </span>

                                <div class="flex-fill">
                                  <div class="fw-semibold">{{ __('Postal Code') }}</div>
                                  <div class="small {{ postalValid ? 'text-green' : 'text-red' }}">{{ postalValid ? __('Format is valid') : __('Format is not valid') }}</div>
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endif %}

                      </div>
                    </div>
                </div>
              
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 class="card-title">
                            {{ __('Administrative Actions') }}
                        </h3>
                    </div>

                    <form method="post" action="/contact/approve">
                        {{ csrf.field | raw }}

                        <div class="card-body">
                            <div class="mb-3">
                                <label for="validation-note" class="form-label">{{ __('Audit Note') }}</label>

                                <textarea id="validation-note" name="note" class="form-control" rows="4" maxlength="5000" placeholder="{{ __('Optional note for a status change, or enter a note and click Add Audit Note') }}"></textarea>
                            </div>
                        </div>

                        <div class="card-footer">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" name="action" value="validate" class="btn btn-success">{{ __('Mark as Validated') }}</button>

                                <button type="submit" name="action" value="unvalidate" class="btn btn-warning">{{ __('Mark as Unvalidated') }}</button>

                                <button type="submit" name="action" value="note" class="btn btn-primary">{{ __('Add Audit Note') }}</button>
                            </div>
                        </div>
                    </form>
                </div>

                {% if sumsub_enabled %}
                <div class="card mb-3">
                  <div class="card-body">
                    <div class="d-flex align-items-start">
                      <span class="avatar avatar-md bg-primary-lt me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M11.46 20.846a12 12 0 0 1 -7.96 -14.846a12 12 0 0 0 8.5 -3a12 12 0 0 0 8.5 3a12 12 0 0 1 -.09 7.06" /><path d="M15 19l2 2l4 -4" /></svg>
                      </span>

                      <div class="flex-fill">
                        <h3 class="card-title mb-1">
                          {{ __('Identity Verification') }}
                        </h3>

                        <p class="text-secondary mb-3">
                          {{ __('Complete a secure identity verification to confirm your contact details. You will be redirected to our verification provider to continue.') }}
                        </p>

                        <form action="/contact/identity" method="post">
                          {{ csrf.field | raw }}

                          <button type="submit" class="btn btn-outline-primary">
                            {{ __('Verify Identity') }}
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
                {% endif %}

                <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">{{ __('Validation Audit Log') }}</h3>

                    {% if validationLog is not empty %}
                      <div class="card-actions">
                        <span class="badge bg-blue-lt text-blue">{{ validationLog|length }} {{ validationLog|length == 1 ? __('entry') : __('entries') }}</span>
                      </div>
                    {% endif %}
                  </div>

                  <div class="card-body">
                    {% if validationLog is not empty %}
                      <pre class="mb-0" style="white-space: pre-wrap; overflow-wrap: anywhere;"><code>{% for entry in validationLog %}{{ entry }}{% if not loop.last %}{{ "\n" }}{% endif %}{% endfor %}</code></pre>
                    {% else %}
                      <div class="empty py-4">
                        <div class="empty-icon">
                          <span class="avatar avatar-lg bg-secondary-lt text-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 6l11 0" /><path d="M9 12l11 0" /><path d="M9 18l11 0" /><path d="M5 6l0 .01" /><path d="M5 12l0 .01" /><path d="M5 18l0 .01" /></svg>
                          </span>
                        </div>
                        <p class="empty-title">{{ __('No audit entries') }}</p>
                        <p class="empty-subtitle text-secondary">{{ __('Validation actions and administrative notes will appear here.') }}</p>
                      </div>
                    {% endif %}
                  </div>

                  {% if validationStamp %}
                    <div class="card-footer">
                      <div class="d-flex align-items-center text-secondary small">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                          <path d="M12 7v5l3 3"/>
                          <path d="M12 21a9 9 0 1 0 0 -18a9 9 0 0 0 0 18"/>
                        </svg>
                        <span>{{ __('Last status change') }}: <strong class="text-body">{{ validationStamp }}</strong></span>
                      </div>
                    </div>
                  {% endif %}
                </div>

            </div>
          </div>
        </div>
        {% include 'partials/footer.twig' %}
      </div>
{% endblock %}