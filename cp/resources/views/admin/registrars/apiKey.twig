{% extends "layouts/app.twig" %}

{% block title %}{{ __('Registry API Key') }}{% endblock %}

{% block content %}
<div class="page-wrapper">
  <div class="page-header d-print-none">
    <div class="container-xl">
      <div class="row align-items-center">
        <div class="col">
          <div class="page-pretitle">{{ __('Registry API') }}</div>
          <h2 class="page-title">{{ registrar.name }}</h2>
        </div>
      </div>
    </div>
  </div>

  <div class="page-body">
    <div class="container-xl">
      {% include 'partials/flash.twig' %}

      <div class="row row-cards justify-content-center">
        <div class="col-12 col-lg-8">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1 -4.069 0l-.301 -.301l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.877 2.877 0 0 1 0 -4.069l2.643 -2.643a2.877 2.877 0 0 1 4.069 0" /><path d="M15 9h.01" /></svg>
                {{ __('API Key Management') }}
              </h3>
            </div>

            <div class="card-body">
              <p class="text-secondary">
                {{ __('Use this key as a Bearer token to access the read-only Registry API.') }}
              </p>

              {% if apiKey %}
                <div class="mb-3">
                  <label class="form-label" for="api-key">
                    {{ __('API Key') }}
                  </label>

                  <div class="input-group">
                    <input
                      id="api-key"
                      type="password"
                      class="form-control font-monospace"
                      value="{{ apiKey }}"
                      readonly
                      autocomplete="off"
                      spellcheck="false"
                    >

                    <button
                      id="api-key-reveal"
                      class="btn btn-outline-secondary btn-icon"
                      type="button"
                      title="{{ __('Show for 3 seconds') }}"
                      aria-label="{{ __('Show for 3 seconds') }}"
                      aria-pressed="false"
                      data-show-label="{{ __('Show for 3 seconds') }}"
                      data-hide-label="{{ __('Hide API key') }}"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" id="api-key-eye"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                    </button>

                    <button
                      id="api-key-copy"
                      class="btn btn-outline-secondary"
                      type="button"
                      title="{{ __('Copy API key') }}"
                      data-copied="{{ __('Copied to clipboard') }}"
                      data-failed="{{ __('Unable to copy API key') }}"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon" id="api-key-copy-icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666" /><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1" /></svg>
                      {{ __('Copy') }}
                    </button>
                  </div>

                  <div
                    id="api-key-status"
                    class="small mt-2"
                    role="status"
                    aria-live="polite"
                  ></div>
                </div>

                <div class="alert alert-info mb-0" role="alert">
                  <div class="d-flex">
                    <div>
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-2"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" /></svg>
                    </div>
                    <div>
                      {{ __('Keep this key confidential. Use HTTPS and send it in the Authorization: Bearer header.') }}
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="empty py-4">
                  <div class="empty-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10.17 6.159l2.316 -2.316a2.877 2.877 0 0 1 4.069 0l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.33 2.33" /><path d="M14.931 14.948a2.863 2.863 0 0 1 -1.486 -.79l-.301 -.302l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.863 2.863 0 0 1 -.794 -1.504" /><path d="M15 9h.01" /><path d="M3 3l18 18" /></svg>
                  </div>
                  <p class="empty-title">{{ __('No API key generated') }}</p>
                  <p class="empty-subtitle text-secondary">
                    {{ __('Generate an API key to start using the Registry API.') }}
                  </p>
                </div>
              {% endif %}
            </div>

            <div class="card-footer">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                  <div class="fw-semibold">
                    {{ apiKey ? __('Regenerate API Key') : __('Generate API Key') }}
                  </div>
                  <div class="text-secondary small">
                    {% if apiKey %}
                      {{ __('Regeneration immediately invalidates the previous key.') }}
                    {% else %}
                      {{ __('Create a new key for this registrar.') }}
                    {% endif %}
                  </div>
                </div>

                <form
                  id="api-key-form"
                  method="post"
                  action="{{ isAdmin ? '/registrar/api-key/' ~ registrar.clid : route('registrar.apiKey') }}"
                  data-confirm="{{ __('Regenerate API key? The existing key will stop working immediately.') }}"
                >
                  {{ csrf.field | raw }}

                  <button
                    class="btn {{ apiKey ? 'btn-outline-danger' : 'btn-primary' }}"
                    type="submit"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-2"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" /><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" /></svg>
                    {{ apiKey ? __('Regenerate Key') : __('Generate Key') }}
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const input = document.getElementById('api-key');
  const reveal = document.getElementById('api-key-reveal');
  const eye = document.getElementById('api-key-eye');
  const copy = document.getElementById('api-key-copy');
  const copyIcon = document.getElementById('api-key-copy-icon');
  const status = document.getElementById('api-key-status');
  const form = document.getElementById('api-key-form');

  let revealTimer;
  let copyTimer;

  function hideKey() {
    if (!input) return;

    clearTimeout(revealTimer);
    input.type = 'password';

    reveal.setAttribute('aria-pressed', 'false');
    reveal.setAttribute('aria-label', reveal.dataset.showLabel);
    reveal.title = reveal.dataset.showLabel;
  }

  if (input && reveal) {
    reveal.addEventListener('click', function () {
      clearTimeout(revealTimer);

      input.type = 'text';

      reveal.setAttribute('aria-pressed', 'true');
      reveal.setAttribute('aria-label', reveal.dataset.hideLabel);
      reveal.title = reveal.dataset.hideLabel;

      revealTimer = setTimeout(hideKey, 3000);
    });

    // Also hide if the user switches tabs or windows.
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) hideKey();
    });

    window.addEventListener('blur', hideKey);
    window.addEventListener('pagehide', hideKey);
  }

  if (input && copy) {
    copy.addEventListener('click', async function () {
      clearTimeout(copyTimer);

      try {
        await navigator.clipboard.writeText(input.value);

        copyIcon.className = 'text-success';
        status.className = 'small mt-2 text-success';
        status.textContent = copy.dataset.copied;
      } catch (error) {
        status.className = 'small mt-2 text-danger';
        status.textContent = copy.dataset.failed;
      }

      copyTimer = setTimeout(function () {
        copyIcon.className = 'me-1';
        status.textContent = '';
      }, 2000);
    });
  }

  if (form && input) {
    form.addEventListener('submit', function (event) {
      if (!window.confirm(form.dataset.confirm)) {
        event.preventDefault();
      }
    });
  }
});
</script>
{% endblock %}