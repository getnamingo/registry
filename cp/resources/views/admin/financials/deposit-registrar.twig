{% extends "layouts/app.twig" %}

{% block title %}{{ __('Registrar Deposit') }}{% endblock %}

{% block content %}
<link href="/assets/css/sweetalert2.min.css" rel="stylesheet">
<style>
    .payment-provider-nicky {
        display: inline-block;
        background-image: url('/assets/nicky.svg');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    .payment-provider-plata {
        display: inline-block;
        background-image: url('/assets/plata.svg');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    [data-bs-theme="dark"] .payment-provider-plata {
        background-image: url('/assets/plata-dark.svg');
    }
    .payment-provider-liqpay {
        display: inline-block;
        background-image: url('/assets/liqpay.svg');
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    [data-bs-theme="dark"] .payment-provider-liqpay {
        background-image: url('/assets/liqpay-dark.svg');
    }
    .payment-provider-revolut {
        align-items: center;
        background: #fff;
        border: 1px solid #d6d8dc;
        border-radius: 4px;
        color: #111;
        display: inline-flex;
        font-size: 13px;
        font-weight: 800;
        justify-content: center;
    }
    .payment-provider-revolut::before {
        content: 'R';
    }
</style>
      <div class="page-wrapper">
        <!-- Page header -->
        <div class="page-header d-print-none">
          <div class="container-xl">
            <div class="row g-2 align-items-center">
              <div class="col">
                <!-- Page pre-title -->
                <div class="page-pretitle">
                  {{ __('Overview') }}
                </div>
                <h2 class="page-title">
                  {{ __('Registrar Deposit') }}
                </h2>
              </div>
            </div>
          </div>
        </div>
        <!-- Page body -->
        <div class="page-body">
          <div class="container-xl">
            <div class="col-12">
            {% include 'partials/flash.twig' %}
              <div class="card">
                <div class="card-body">
                  <form id="depositForm" action="#" method="post">
                  {{ csrf.field | raw }}                 
                    <div class="deposit-info">
                        <h5>{{ __('Current Balance for') }} {{ balance_user.name }}</h5>
                        <p class="fs-4">{{ currency }} {{ balance_user.accountBalance }}</p>
                    </div>

                    <div class="mb-3">
                        <label for="amount" class="form-label required">{{ __('Amount') }}</label>
                        <input type="number" step="0.01" class="form-control" id="amount" name="amount" placeholder="{{ __('Enter deposit amount') }}" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">{{ __('Payment Method') }}</label>
                        <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column">
                            {% if 'stripe' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="stripe" class="form-selectgroup-input" required>
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-stripe-dark payment-xs me-2"></span>
                                        {{ __('Stripe') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'liqpay' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="liqpay" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-liqpay payment-xs me-2"></span>
                                        {{ __('LiqPay') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'revolut' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="revolut" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-revolut payment-xs me-2"></span>
                                        {{ __('Revolut Card') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'revolutpay' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="revolutpay" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-revolut payment-xs me-2"></span>
                                        {{ __('Revolut Pay') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'plata' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="plata" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-plata payment-xs me-2"></span>
                                        {{ __('Plata by mono') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'adyen' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="adyen" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-adyen-dark payment-xs me-2"></span>
                                        {{ __('Adyen') }}
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'nicky' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="nicky" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-nicky payment-xs me-2"></span>
                                        {{ __('Crypto') }}: Nicky
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                            {% if 'now' in enabledGateways %}
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="paymentMethod" value="now" class="form-selectgroup-input">
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </div>
                                    <div>
                                        <span class="payment payment-provider-bitcoin-dark payment-xs me-2"></span>
                                        {{ __('Crypto') }}: NOW
                                    </div>
                                </div>
                            </label>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                  <div class="row align-items-center">
                    <div class="d-grid gap-2 d-md-block">
                      <button type="submit" class="btn btn-primary">{{ __('Add Deposit') }}</button>
                    </div>
                  </div>
                </div>
                </form>
                </div>
              </div>
            </div>
          </div>
        </div>
        {% include 'partials/footer.twig' %}
      </div>
<script>
const enabledGateways = {{ enabledGateways|json_encode|raw }};

document.getElementById('depositForm').addEventListener('submit', function (e) {
    e.preventDefault();

    const formData = new FormData(this);
    const paymentMethod = formData.get('paymentMethod');
    const amount = document.getElementById('amount')?.value?.trim();
    if (!amount || isNaN(amount) || parseFloat(amount) <= 0) {
        Swal.fire({
            icon: 'warning',
            title: '{{ __("Invalid Amount") }}',
            text: '{{ __("Please enter a valid deposit amount.") }}'
        });
        return;
    }

    if (!enabledGateways.includes(paymentMethod)) {
        showError('{{ __("Error") }}', '{{ __("This payment method is not available.") }}');
        return;
    }

    if (paymentMethod === 'liqpay') {
        this.action = '/payment/liqpay/create';
        this.method = 'POST';
        this.submit();
        return;
    }

    sendPayment(`/payment/${encodeURIComponent(paymentMethod)}/create`, formData, (data) => {
        if (paymentMethod === 'revolut') {
            startRevolutCard(data);
            return;
        }
        if (paymentMethod === 'revolutpay') {
            startRevolutPay(data);
            return;
        }
        window.location.assign(data.url);
    });
});

let revolutSdkPromise = null;
let activeRevolutPayments = null;

function loadRevolutSdk(embedHost) {
    const allowedHosts = [
        'https://merchant.revolut.com',
        'https://sandbox-merchant.revolut.com'
    ];
    if (!allowedHosts.includes(embedHost)) {
        return Promise.reject(new Error('Invalid Revolut SDK host.'));
    }
    if (typeof window.RevolutCheckout === 'function') {
        return Promise.resolve(window.RevolutCheckout);
    }
    if (revolutSdkPromise) {
        return revolutSdkPromise;
    }

    revolutSdkPromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = `${embedHost}/embed.js`;
        script.async = true;
        script.onload = () => {
            if (typeof window.RevolutCheckout === 'function') {
                resolve(window.RevolutCheckout);
            } else {
                reject(new Error('The Revolut SDK did not initialise.'));
            }
        };
        script.onerror = () => reject(new Error('The Revolut SDK could not be loaded.'));
        document.head.appendChild(script);
    }).catch(error => {
        revolutSdkPromise = null;
        throw error;
    });

    return revolutSdkPromise;
}

function revolutErrorText(error) {
    if (error && typeof error.message === 'string' && error.message !== '') {
        return error.message;
    }
    return '{{ __("The payment was not completed. Please try again.") }}';
}

function startRevolutCard(data) {
    if (data.checkout !== 'card' || !data.order_token || !data.return_url) {
        showError('{{ __("Payment Error") }}', '{{ __("Revolut returned incomplete checkout data.") }}');
        return;
    }

    loadRevolutSdk(data.embed_host)
        .then(RevolutCheckout => RevolutCheckout(data.order_token, data.mode))
        .then(checkout => {
            checkout.payWithPopup({
                name: data.customer_name || undefined,
                email: data.customer_email || undefined,
                locale: 'auto',
                onSuccess: () => finishRevolutPayment(data),
                onError: error => showError(
                    '{{ __("Payment Error") }}',
                    revolutErrorText(error)
                )
            });
        })
        .catch(error => showError(
            '{{ __("Payment Error") }}',
            revolutErrorText(error)
        ));
}

function startRevolutPay(data) {
    if (
        data.checkout !== 'revolut_pay'
        || !data.public_key
        || !data.order_token
        || !data.return_url
    ) {
        showError('{{ __("Payment Error") }}', '{{ __("Revolut returned incomplete checkout data.") }}');
        return;
    }

    Swal.fire({
        title: '{{ __("Pay with Revolut") }}',
        html: '<div id="revolut-pay-widget" style="min-height:48px"></div>'
            + '<div id="revolut-pay-error" class="text-danger mt-3" role="alert"></div>',
        showConfirmButton: false,
        showCloseButton: true,
        allowOutsideClick: false,
        didOpen: () => {
            const target = document.getElementById('revolut-pay-widget');
            const errorBox = document.getElementById('revolut-pay-error');

            loadRevolutSdk(data.embed_host)
                .then(RevolutCheckout => RevolutCheckout.payments({
                    publicToken: data.public_key,
                    mode: data.mode,
                    locale: 'auto'
                }))
                .then(payments => {
                    if (!payments || !payments.revolutPay) {
                        throw new Error('Revolut Pay is not available for this merchant account.');
                    }

                    activeRevolutPayments = payments;
                    payments.revolutPay.mount(target, {
                        currency: data.currency,
                        totalAmount: data.amount_minor,
                        createOrder: () => Promise.resolve({ publicId: data.order_token }),
                        mobileRedirectUrls: {
                            success: data.return_url,
                            failure: data.return_url,
                            cancel: data.return_url
                        },
                        buttonStyle: {
                            action: 'pay',
                            size: 'large',
                            cashback: false
                        }
                    });

                    payments.revolutPay.on('payment', event => {
                        if (event && event.type === 'success') {
                            finishRevolutPayment(data);
                        } else if (event && event.type === 'error') {
                            errorBox.textContent = revolutErrorText(event.error);
                        }
                    });
                })
                .catch(error => {
                    errorBox.textContent = revolutErrorText(error);
                });
        },
        didClose: () => {
            if (activeRevolutPayments && typeof activeRevolutPayments.destroy === 'function') {
                activeRevolutPayments.destroy();
            }
            activeRevolutPayments = null;
        }
    });
}

function sendPayment(url, formData, onSuccess) {
    fetch(url, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.error) {
            console.error(`${url} Error:`, data.error);
            showError('{{ __("Payment Error") }}', data.error);
        } else {
            console.log(`${url} success:`, data);
            onSuccess(data);
        }
    })
    .catch(err => {
        console.error(`Error in ${url}:`, err);
        showError('{{ __("Unexpected Error") }}', '{{ __("An unexpected error occurred. Please try again later. Ensure the payment gateway is properly configured.") }}');
    });
}

function showError(title, text) {
    Swal.fire({ icon: 'error', title, text });
}

function finishRevolutPayment(data) {
    Swal.fire({
        icon: 'success',
        title: '{{ __("Payment confirmed") }}',
        text: '{{ __("Updating your balance…") }}',
        showConfirmButton: false,
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    setTimeout(() => {
        window.location.assign(data.return_url);
    }, 12000);
}
</script>
{% endblock %}