{% extends 'layouts/auth.twig' %}
{% block title %}Application Status{% endblock %}
{% block content %}
<div class="container container-tight py-5"><div class="card"><div class="card-body">
  <h1 class="card-title">{{ application.details.name }}: application</h1>
  <p>Status: <strong>{{ application.status }}</strong></p>
  {% if application.status == 'pendingAgreement' %}
    <p>Your application is saved. Sign the registrar agreement to send it for review.</p>
    <a class="btn btn-primary" href="/onboarding/contract/{{ application.public_token }}">Review and sign agreement</a>
  {% else %}
    <p>{% if application.status == 'signed' %}Your agreement is signed and awaits registry approval.
       {% elseif application.status == 'approved' %}Your application has been approved. The registry will provide login details securely.
       {% else %}Your application was not approved. Contact the registry for details.{% endif %}</p>
    <a class="btn btn-outline-primary" href="/onboarding/contract/{{ application.public_token }}">View agreement</a>
    {% if application.signature %}
      <a class="btn btn-outline-primary" href="/onboarding/contract/{{ application.public_token }}/pdf">Download signed PDF</a>
    {% endif %}
  {% endif %}
  {% if application.details._onboarding_fee is defined %}
    {% set fee = application.details._onboarding_fee %}
    <div class="mt-3">
      {% if fee.paid %}
        <span class="badge bg-success text-success-fg">Onboarding fee paid</span>
      {% elseif application.status == 'signed' %}
        {% set zeroDecimal = fee.currency in ['BIF', 'CLP', 'DJF', 'GNF', 'JPY', 'KMF', 'KRW', 'MGA', 'PYG', 'RWF', 'VND', 'VUV', 'XAF', 'XOF', 'XPF'] %}
        <p>Onboarding fee: <strong>{{ (fee.amount_minor / (zeroDecimal ? 1 : 100))|number_format(zeroDecimal ? 0 : 2) }} {{ fee.currency }}</strong></p>
        <form method="post" action="/onboarding/application/{{ application.public_token }}/pay">
          {{ csrf.field|raw }}
          <button type="submit" class="btn btn-primary">Pay onboarding fee with Stripe</button>
        </form>
        <p class="text-secondary mt-2">Payment is required before registry approval. Return here after paying.</p>
      {% endif %}
    </div>
  {% endif %}
  <p class="text-secondary mt-4">Keep this private link to revisit your application. Anyone with the link can view the application and agreement.</p>
  <div class="input-group"><input class="form-control" aria-label="Application link" readonly value="{{ application.public_token }}"><button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(location.href)">Copy link</button></div>
  <form method="post" action="/onboarding/application/{{ application.public_token }}/hide" class="mt-4">
    {{ csrf.field|raw }}
    <button class="btn btn-outline-danger" type="submit" onclick="return confirm('Permanently disable this public link? You will no longer be able to view or sign the application using this link. The registry administrator will still have access.')">Hide application from public access</button>
  </form>
</div></div></div>
{% endblock %}
