{% extends 'layouts/auth.twig' %}
{% block title %}Registrar Accreditation Agreement{% endblock %}
{% block content %}
{% set d = application.details %}
<div class="container py-5" style="max-width:900px">
  <div class="card"><div class="card-body">
    {{ application.agreement_html|raw }}
    {% if application.signature %}
      <hr><p>Signed by {{ d.ownerFirstName }} {{ d.ownerLastName }} on {{ application.signed_at }} (registry database time). Recorded IP: {{ application.signed_ip }}.</p>
      <img src="{{ application.signature }}" width="420" height="130" alt="Registrar signature" style="max-width:100%;border:1px solid #ccc;object-fit:contain">
    {% elseif not admin and application.status == 'pendingAgreement' %}
      <hr><h2>Sign agreement</h2>
      {% if error is defined %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
      <form action="/onboarding/contract/{{ application.public_token }}" method="post" id="sign-form">
        {{ csrf.field|raw }}
        <canvas id="signature-pad" width="500" height="150" style="width:100%;max-width:500px;height:150px;border:1px solid #bbb;touch-action:none;display:block"></canvas>
        <input type="hidden" id="signature" name="signature">
        <div class="mt-3 d-flex gap-2"><button type="button" id="clear" class="btn btn-outline-secondary">Clear</button>
          <button type="submit" class="btn btn-primary">Sign and submit</button></div>
      </form>
      <script>
      (() => {
        const canvas = document.getElementById('signature-pad');
        const ctx = canvas.getContext('2d');
        ctx.strokeStyle = '#1a4a7a'; ctx.lineWidth = 2.5; ctx.lineCap = 'round';
        let drawing = false, marked = false;
        const point = e => { const r=canvas.getBoundingClientRect(); return [(e.clientX-r.left)*canvas.width/r.width,(e.clientY-r.top)*canvas.height/r.height]; };
        canvas.addEventListener('pointerdown', e => { e.preventDefault(); canvas.setPointerCapture(e.pointerId); drawing=true; const [x,y]=point(e); ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x+0.1,y+0.1); ctx.stroke(); marked=true; });
        canvas.addEventListener('pointermove', e => { if (!drawing) return; e.preventDefault(); const [x,y]=point(e); ctx.lineTo(x,y); ctx.stroke(); });
        canvas.addEventListener('pointerup', () => { drawing=false; });
        canvas.addEventListener('pointercancel', () => { drawing=false; });
        document.getElementById('clear').onclick = () => { ctx.clearRect(0,0,canvas.width,canvas.height); marked=false; };
        document.getElementById('sign-form').onsubmit = e => { if (!marked) { e.preventDefault(); alert('Please sign the agreement.'); return; } document.getElementById('signature').value=canvas.toDataURL('image/png'); };
      })();
      </script>
    {% endif %}
    <p class="mt-4"><a href="{{ admin ? '/onboarding/admin' : '/onboarding/application/' ~ application.public_token }}">Return</a></p>
  </div></div>
</div>
{% endblock %}
