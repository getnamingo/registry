{% extends 'layouts/auth.twig' %}
{% block title %}Registrar Approved{% endblock %}
{% block content %}
<div class="container container-tight py-5"><div class="card"><div class="card-body">
<h1>Registrar created: {{ registrar }}</h1>
<div class="alert alert-warning">These passwords are shown once. Share them with the registrar using a secure channel; they are not emailed automatically.</div>
<p>Portal login email: <code>{{ email }}</code><br>EPP client ID: <code>{{ clid }}</code></p>
<p>Portal password: <code>{{ panelPassword }}</code></p>
<p>EPP password: <code>{{ eppPassword }}</code></p>
<a href="/onboarding/admin" class="btn btn-primary">Back to applications</a>
</div></div></div>
{% endblock %}
