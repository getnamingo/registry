{
	admin 127.0.0.1:2019
	email {$NAMINGO_ADMIN_EMAIL}
}

cp.{$NAMINGO_DOMAIN} {
	{$NAMINGO_CADDY_TLS_DIRECTIVE}
	encode zstd gzip
	header -Server
	log {
		output stdout
		format json
	}

	@health path /healthz
	respond @health "ok" 200

	root * /var/www/cp/public
	php_fastcgi 127.0.0.1:9000
	file_server

	header {
		Referrer-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; connect-src 'self' https://*.revolut.com; img-src https: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.revolut.com; form-action 'self'; worker-src 'none'; frame-src https://*.revolut.com"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), usb=()"
	}
}

rdap.{$NAMINGO_DOMAIN} {
	{$NAMINGO_CADDY_TLS_DIRECTIVE}
	encode zstd gzip
	header -Server
	log {
		output stdout
		format json
	}

	@health path /healthz
	respond @health "ok" 200

	reverse_proxy 127.0.0.1:7500
	header {
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; img-src https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; form-action 'self'; worker-src 'none'; frame-src 'none'"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), usb=()"
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
	}
}

whois.{$NAMINGO_DOMAIN} {
	{$NAMINGO_CADDY_TLS_DIRECTIVE}
	encode zstd gzip
	header -Server
	log {
		output stdout
		format json
	}

	@health path /healthz
	respond @health "ok" 200

	root * /var/www/whois
	php_fastcgi 127.0.0.1:9000
	file_server

	header {
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; connect-src 'self' https:; img-src https: data:; font-src 'self'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; form-action 'self'; worker-src 'self' blob:; frame-src 'none'"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), usb=()"
	}
}

epp.{$NAMINGO_DOMAIN} {
	{$NAMINGO_CADDY_TLS_DIRECTIVE}
	encode zstd gzip
	header -Server
	log {
		output stdout
		format json
	}
	redir https://cp.{$NAMINGO_DOMAIN}{uri} permanent
}
