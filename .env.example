# Namingo Registry Docker deployment
COMPOSE_PROJECT_NAME=namingo

# The four public names are cp., rdap., whois., and epp. below this domain.
NAMINGO_DOMAIN=example.com
NAMINGO_ADMIN_EMAIL=admin@example.com
NAMINGO_ADMIN_USERNAME=admin
NAMINGO_TIMEZONE=UTC

# public: Let's Encrypt through Caddy; internal: Caddy's local development CA.
NAMINGO_TLS_MODE=public
NAMINGO_CADDY_TLS_DIRECTIVE=tls admin@example.com

# Published host ports. Change NAMINGO_BIND_ADDRESS to 127.0.0.1 for local-only use.
NAMINGO_BIND_ADDRESS=0.0.0.0
NAMINGO_HTTP_PORT=80
NAMINGO_HTTPS_PORT=443
NAMINGO_EPP_PORT=700
NAMINGO_WHOIS_PORT=43
NAMINGO_DAS_PORT=1043

# Database names must remain these values for the current Namingo schema.
NAMINGO_DB_HOST=database
NAMINGO_DB_PORT=3306
NAMINGO_DB_NAME=registry
NAMINGO_DB_USER=namingo

# Registry defaults. Complete the remaining operator data in the control panel.
NAMINGO_ROID=XX
NAMINGO_TEST_TLDS=.test,.com.test
NAMINGO_MINIMUM_DATA=false
NAMINGO_WHOIS_PRIVACY=false
NAMINGO_WHOIS_LIMITED=false
NAMINGO_RDAP_LIMITED=false
NAMINGO_RATE_LIMIT=false
NAMINGO_RATE_LIMIT_REQUESTS=1000
NAMINGO_RATE_LIMIT_PERIOD=60
NAMINGO_WEB_WHOIS_CAPTCHA=false

# EPP mutual TLS is available after placing the registrar CA bundle in the image
# or setting its path in docker/config/epp.override.php.
NAMINGO_EPP_REQUIRE_CLIENT_CERT=false
NAMINGO_CERT_SYNC_ENABLED=true
NAMINGO_CERT_SYNC_INTERVAL=300

# Zone generation defaults. DNS reload is deliberately off until a hidden
# primary is connected; generated BIND zones persist in the `zones` volume.
NAMINGO_DNS_SERVER=bind
NAMINGO_DNS_RELOAD=false
NAMINGO_NAMESERVERS=ns1.example.com,ns2.example.com
NAMINGO_DNS_SOA=hostmaster.example.com
NAMINGO_DNS_SERIAL=1

# Optional scheduled jobs (safe core lifecycle jobs always run).
NAMINGO_CRON_ACCOUNTING=false
NAMINGO_CRON_BACKUP=false
NAMINGO_CRON_BACKUP_UPLOAD=false
NAMINGO_CRON_GTLD_MODE=false
NAMINGO_CRON_SPEC11=false
NAMINGO_CRON_SPEC11_IQ=false
NAMINGO_CRON_EXCHANGE_RATES=false
NAMINGO_CRON_CDS_SCANNER=false

# Mail is disabled until configured. Use smtp, utopia, msg, or none.
MAIL_DRIVER=none
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_TO_ADDRESS=
MAIL_FROM_NAME=Registry
MAIL_API_KEY=
MAIL_API_PROVIDER=sendgrid
NAMINGO_MESSAGE_MAILER=phpmailer
NAMINGO_SMS_PROVIDER=twilio
NAMINGO_SMS_ACCOUNT=
NAMINGO_SMS_AUTH=
NAMINGO_SMS_FROM=

# Optional payment/KYC configuration for the control panel.
ENABLED_GATEWAYS=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
REVOLUT_SANDBOX=true
REVOLUT_SECRET_KEY=
REVOLUT_PUBLIC_KEY=
REVOLUT_API_VERSION=2024-09-01
REVOLUT_CARD_WEBHOOK_SECRET=
REVOLUT_PAY_WEBHOOK_SECRET=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
PLATA_TOKEN=
ADYEN_API_KEY=
ADYEN_MERCHANT_ID=
ADYEN_THEME_ID=
ADYEN_BASE_URI=https://checkout-test.adyen.com/v70/
ADYEN_BASIC_AUTH_USER=
ADYEN_BASIC_AUTH_PASS=
ADYEN_HMAC_KEY=
NOW_API_KEY=
NICKY_API_KEY=
SUMSUB_TOKEN=
SUMSUB_KEY=

# Image versions can be pinned by an operator without editing compose.yaml.
NAMINGO_IMAGE=namingo-registry:local
NAMINGO_WEB_IMAGE=namingo-registry-web:local
NAMINGO_PHP_VERSION=8.5
NAMINGO_BUILD_JOBS=2
NAMINGO_MARIADB_IMAGE=mariadb:11.8
NAMINGO_REDIS_IMAGE=redis:8.2-alpine
